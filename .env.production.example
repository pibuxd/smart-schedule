# Settings for the VPS. Copy to .env on the server and fill in every CHANGE-ME (docs/deploy.md).
# Never commit .env.

# Use the production additions (ports 80/443, database not exposed) with every `docker compose` command.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The domain that points at the server (DNS record A). Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=CHANGE-ME.pl

# Django
DJANGO_DEBUG=0
# openssl rand -hex 32
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_ALLOWED_HOSTS=CHANGE-ME.pl,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://CHANGE-ME.pl

# Login codes. Until an SMS gateway is connected the code is written to the server log:
#   docker compose logs api --since 5m | grep "SMS to"
SMS_BACKEND=apps.accounts.sms.ConsoleSmsSender

# PostgreSQL (openssl rand -hex 24). Changing the password later needs a change in the database too.
POSTGRES_DB=grafikomat
POSTGRES_USER=grafikomat
POSTGRES_PASSWORD=CHANGE-ME

# Workers, sized for 2 vCPU / 4 GB RAM
WORKER_CONCURRENCY=2
SOLVER_CONCURRENCY=1
SOLVER_TIME_LIMIT_S=30
SOLVER_WORKERS=2

# The assistant: OpenRouter key (openrouter.ai/keys). Empty = requests go to the manager uninterpreted.
# The model defaults to deepseek/deepseek-v4.1-flash and thinking to low; to change them, set
# OPENROUTER_MODEL=<id from openrouter.ai/models> and OPENROUTER_EFFORT=none|minimal|low|medium|high|xhigh.
OPENROUTER_API_KEY=
# Claude API instead of OpenRouter (used only when OPENROUTER_API_KEY is empty).
ANTHROPIC_API_KEY=
# Limits on writing to the assistant are off by default (0 = no limit). To turn one on, uncomment it and set a
# number (earlier defaults: 400 messages from one company's managers a month, 10 saved requests of one person per
# period, 40 messages of one person a day).
# ASSISTANT_COMMANDS_MONTHLY_LIMIT=400
# TEXT_REQUESTS_PER_PERIOD=10
# ASSISTANT_MESSAGES_PER_DAY=40

# Optional: address that gets a short message (HTTP POST) when an automatic update fails twice,
# e.g. a private topic at https://ntfy.sh/<long-random-name> with the ntfy app on your phone. Empty = log only.
DEPLOY_ALERT_URL=

# Login code limits (defaults 20 per address and 5 per number an hour). Raise them only for a test session with many
# test accounts from one address, then remove the lines again and run deploy/update.sh.
# LOGIN_CODES_PER_IP_PER_HOUR=200
# LOGIN_CODES_PER_PHONE_PER_HOUR=20
