# Settings for the VPS. Copy to .env on the server and fill in every CHANGE-ME (docs/deploy.md).
# Never commit .env.

# Use the production additions (ports 80/443, database not exposed) with every `docker compose` command.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The domain that points at the server (DNS record A). Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=CHANGE-ME.pl

# Django
DJANGO_DEBUG=0
# openssl rand -hex 32
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_ALLOWED_HOSTS=CHANGE-ME.pl,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://CHANGE-ME.pl

# Login codes. Until an SMS gateway is connected the code is written to the server log:
#   docker compose logs api --since 5m | grep "SMS to"
SMS_BACKEND=apps.accounts.sms.ConsoleSmsSender

# PostgreSQL (openssl rand -hex 24). Changing the password later needs a change in the database too.
POSTGRES_DB=grafikomat
POSTGRES_USER=grafikomat
POSTGRES_PASSWORD=CHANGE-ME

# Workers, sized for 2 vCPU / 4 GB RAM
WORKER_CONCURRENCY=2
SOLVER_CONCURRENCY=1
SOLVER_TIME_LIMIT_S=30
SOLVER_WORKERS=2
GENERATION_MONTHLY_LIMIT=30

# Claude API for interpreting text requests. Empty = requests go to the manager uninterpreted.
ANTHROPIC_API_KEY=

# Optional: address that gets a short message (HTTP POST) when an automatic update fails twice,
# e.g. a private topic at https://ntfy.sh/<long-random-name> with the ntfy app on your phone. Empty = log only.
DEPLOY_ALERT_URL=
