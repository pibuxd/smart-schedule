# One domain: the SPA at /, the API at /api, Django static files (admin) at /static.
# Locally SITE_ADDRESS is ":8080" (plain HTTP). On the VPS set it to the domain and Caddy gets HTTPS itself.
{$SITE_ADDRESS::8080} {
	encode zstd gzip

	# Server-only additions (e.g. a page only this server has): *.caddy files in deploy/local/ on the VPS.
	# That folder is git-ignored, so `git pull` in the auto-update never stops on a local change.
	import /etc/caddy/local/*.caddy

	handle /api/* {
		reverse_proxy api:8000
	}

	handle_path /static/* {
		root * /srv/django-static
		file_server
	}

	handle {
		root * /srv/app
		# Built files have a hash in their name, so they never change; index.html must be checked on every visit,
		# or a browser keeps the old app after a deploy.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
