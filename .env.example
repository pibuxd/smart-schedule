# Copy to .env (never commit .env). Values below are for local runs only.

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173

# Login codes. The default sender writes the SMS to the server log. The szybkisms.pl gateway:
# SMS_BACKEND=apps.accounts.sms.SzybkiSmsSender with SZYBKISMS_TOKEN (REST API token from its panel), optionally
# SZYBKISMS_SENDER (an approved sender name; empty = the account's default) and SZYBKISMS_SANDBOX=1 (sends nothing).
SMS_BACKEND=apps.accounts.sms.ConsoleSmsSender
SZYBKISMS_TOKEN=
SZYBKISMS_SENDER=
SZYBKISMS_SANDBOX=0
# The closed test of the phone apps (docs/mobile.md, "Lokal testerów"): the location id printed by
# `manage.py tester_location --name "…"`. New Polish numbers then join it as 3 managers and 15 employees.
# Empty = off; empty it before the app is published for everyone.
TESTERS_LOCATION_ID=
TESTERS_MANAGERS=3
TESTERS_EMPLOYEES=15
# The store reviewers' login: this number always logs in with this 6-digit code and never gets an SMS. Empty = off.
REVIEW_LOGIN_PHONE=
REVIEW_LOGIN_CODE=
# Reverse proxies in front of the API that set X-Forwarded-For (Docker Compose sets 1 for Caddy; 0 for runserver).
DJANGO_NUM_PROXIES=0

# PostgreSQL
POSTGRES_DB=grafikomat
POSTGRES_USER=grafikomat
POSTGRES_PASSWORD=grafikomat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port for the db container (change if 5432 is taken on your machine)
POSTGRES_HOST_PORT=5432

# Caddy: ":8080" locally; on the VPS the domain name, e.g. grafikomat.pl
SITE_ADDRESS=:8080
HTTP_PORT=8080

# Workers: light jobs (queue "default") and the schedule generator (queue "solver", 1-2 jobs at once)
WORKER_CONCURRENCY=2
SOLVER_CONCURRENCY=1
# Seconds one generation may take, and CPU threads it may use
SOLVER_TIME_LIMIT_S=30
SOLVER_WORKERS=8

# The assistant reads employees' text requests and the manager's commands. It uses OpenRouter when
# OPENROUTER_API_KEY is set, else Claude when ANTHROPIC_API_KEY is set.
# Both empty = the assistant is off: requests go to the manager as written, rules are set by hand.
# OpenRouter key (openrouter.ai/keys). Never commit it.
OPENROUTER_API_KEY=
# Model id as on openrouter.ai/models; it must support tool calling.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# How long the model thinks before answering: none, minimal, low (default), medium, high, xhigh. Empty = model default.
OPENROUTER_EFFORT=low
# Claude API (used only when OPENROUTER_API_KEY is empty).
ANTHROPIC_API_KEY=
# Model for the assistant (claude-haiku-5-5 is cheaper and enough for short requests).
ANTHROPIC_MODEL=claude-opus-5-5
# How long the model thinks before answering: low (fastest), medium, high, xhigh, max.
# Empty = the model's default (medium on claude-opus-5-5, noticeably slower with tool rounds).
ANTHROPIC_EFFORT=low
# Limits on writing to the assistant, all off (0 = no limit). A number turns one on: messages from one company's
# managers a month, saved requests of one person per period (questions do not count), messages of one person a day.
ASSISTANT_COMMANDS_MONTHLY_LIMIT=0
TEXT_REQUESTS_PER_PERIOD=0
ASSISTANT_MESSAGES_PER_DAY=0

# The iOS and Android apps (docs/mobile.md). Their origins are allowed by default; change only for a custom build.
# NATIVE_APP_ORIGINS=capacitor://localhost,https://localhost
# Push notifications: key files outside the repository (in Docker: ./secrets, seen as /run/secrets/grafikomat/...).
# Empty = no push; everything is still in the app.
# Apple (APNs): the .p8 key from developer.apple.com > Keys, its Key ID and the Team ID.
PUSH_APNS_KEY_FILE=
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
# Builds run from Xcode get sandbox tokens; the server tries the other service by itself, this only sets the first.
PUSH_APNS_SANDBOX=0
# PUSH_APNS_TOPIC=pl.grafikomat.app
# Google (FCM): the Firebase project's service account JSON (Project settings > Service accounts).
PUSH_FCM_CREDENTIALS_FILE=
