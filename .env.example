# Copy to .env (never commit .env). Values below are for local runs only.

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173

# PostgreSQL
POSTGRES_DB=grafikomat
POSTGRES_USER=grafikomat
POSTGRES_PASSWORD=grafikomat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port for the db container (change if 5432 is taken on your machine)
POSTGRES_HOST_PORT=5432

# Caddy: ":8080" locally; on the VPS the domain name, e.g. grafikomat.pl
SITE_ADDRESS=:8080
HTTP_PORT=8080

# Worker and scheduling engine
WORKER_CONCURRENCY=1
SOLVER_TIME_LIMIT_S=30
GENERATION_MONTHLY_LIMIT=30

# Claude API for interpreting text requests (stage 10). Empty = requests go to the manager uninterpreted.
ANTHROPIC_API_KEY=
