# Copy to .env (never commit .env). Values below are for local runs only.

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173

# Login codes. The default sender writes the SMS to the server log; a real gateway comes with deployment.
SMS_BACKEND=apps.accounts.sms.ConsoleSmsSender
# Reverse proxies in front of the API that set X-Forwarded-For (Docker Compose sets 1 for Caddy; 0 for runserver).
DJANGO_NUM_PROXIES=0

# PostgreSQL
POSTGRES_DB=grafikomat
POSTGRES_USER=grafikomat
POSTGRES_PASSWORD=grafikomat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port for the db container (change if 5432 is taken on your machine)
POSTGRES_HOST_PORT=5432

# Caddy: ":8080" locally; on the VPS the domain name, e.g. grafikomat.pl
SITE_ADDRESS=:8080
HTTP_PORT=8080

# Workers: light jobs (queue "default") and the schedule generator (queue "solver", 1-2 jobs at once)
WORKER_CONCURRENCY=2
SOLVER_CONCURRENCY=1
# Seconds one generation may take, and CPU threads it may use
SOLVER_TIME_LIMIT_S=30
SOLVER_WORKERS=8
GENERATION_MONTHLY_LIMIT=30

# Claude API: the assistant reads employees' text requests and the manager's commands.
# Empty = the assistant is off: requests go to the manager as written, rules are set by hand.
ANTHROPIC_API_KEY=
# Model for the assistant (claude-haiku-5-5 is cheaper and enough for short requests).
ANTHROPIC_MODEL=claude-opus-5-5
